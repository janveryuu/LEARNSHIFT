{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "channel": "production"
    },
    "pitch": {
      "extends": "preview",
      "channel": "pitch",
      "env": {
        "EXPO_PUBLIC_PITCH": "1"
      }
    }
  }
}
